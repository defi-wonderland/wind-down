# RPC for the L1 network to deploy to
L1_RPC=

# Private key for the deployer account
PRIVATE_KEY_DEPLOYER=

# Optional Tenderly details for a simulation link during deployment
TENDERLY_PROJECT=
TENDERLY_USERNAME=

# RPC
ETHEREUM_MAINNET_RPC=
LOCAL_RPC=

# Etherscan API key — required by `yarn deploy-prod:clawback` to auto-verify
# the deployed BalanceClaimer impl on mainnet Etherscan.
ETHERSCAN_API_KEY=

# Address that imported the foundry keystore as `clawback-deployer`.
DEPLOYER_ADDRESS=


# The following settings are useful for manually testing the migration scripts.

# Define if cast commands should be printed.
CAST_COMMANDS=1

# Saves deployment artifacts when using the 'live' network
SAVE_DEPLOYMENTS=1

# Disable the live deployer so that transactions must be submitted manually
DISABLE_LIVE_DEPLOYER=true

# Contracts deployer private keys
PRIVATE_KEY_DEPLOYER=

# Used for test deploy
PRIVATE_KEY_PROXY_ADMIN=

# Balance claimer proxy admin to be set
BALANCE_CLAIMER_PROXY_ADMIN_PUBLIC_ADDRESS=

